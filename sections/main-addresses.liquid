{%- comment -%} Figma: Profile - Settings (171:1391): addresses + account details {%- endcomment -%}
<section class="bg-blush py-12 md:py-16">
  <div class="page-width grid gap-6 lg:grid-cols-[260px_1fr]">
    {% render 'account-nav', active: 'settings' %}
    <div class="space-y-6">
      <div class="rounded-3xl bg-white p-6 shadow-soft">
        <h1 class="font-heading text-3xl font-bold text-ink">{{ 'customer.nav_settings' | t }}</h1>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-soft p-4"><dt class="text-sm text-muted">{{ 'contact.name' | t }}</dt><dd class="font-semibold">{{ customer.name | default: '—' }}</dd></div>
          <div class="rounded-2xl bg-soft p-4"><dt class="text-sm text-muted">{{ 'contact.email' | t }}</dt><dd class="font-semibold">{{ customer.email }}</dd></div>
          <div class="rounded-2xl bg-soft p-4"><dt class="text-sm text-muted">{{ 'contact.phone' | t }}</dt><dd class="font-semibold">{{ customer.phone | default: '—' }}</dd></div>
          <div class="rounded-2xl bg-soft p-4"><dt class="text-sm text-muted">{{ 'customer.marketing_status' | t }}</dt><dd class="font-semibold">{% if customer.accepts_marketing %}{{ 'customer.subscribed' | t }}{% else %}{{ 'customer.not_subscribed' | t }}{% endif %}</dd></div>
        </dl>
      </div>

      <div class="rounded-3xl bg-white p-6 shadow-soft">
        <div class="flex items-center justify-between">
          <h2 class="font-heading text-2xl font-semibold text-ink">{{ 'customer.addresses' | t }}</h2>
          <a href="#AddAddress" class="btn btn--primary h-10 px-5 text-sm">+ {{ 'customer.add_address' | t }}</a>
        </div>
        {%- paginate customer.addresses by 10 -%}
          <ul class="mt-6 grid gap-4 md:grid-cols-2">
            {%- for address in customer.addresses -%}
              <li class="rounded-2xl border border-divider p-5">
                {%- if address == customer.default_address -%}<span class="mb-2 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">{{ 'customer.default' | t }}</span>{%- endif -%}
                <div class="text-sm text-muted">{{ address | format_address }}</div>
                <div class="mt-4 flex gap-4 text-sm font-medium">
                  <a href="#Edit-{{ address.id }}" class="text-primary">{{ 'customer.edit' | t }}</a>
                  {%- form 'customer_address', address, class: 'inline' -%}<input type="hidden" name="_method" value="delete"><button class="text-muted hover:text-primary">{{ 'templates.cart.remove' | t }}</button>{%- endform -%}
                </div>
                <div id="Edit-{{ address.id }}" class="hidden target:block">
                  {%- form 'customer_address', address, class: 'mt-4 grid gap-3' -%}
                    {% render 'address-fields', form: form, prefix: address.id %}
                  {%- endform -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </div>

      <div id="AddAddress" class="scroll-mt-32 rounded-3xl bg-white p-6 shadow-soft">
        <h2 class="font-heading text-2xl font-semibold text-ink">{{ 'customer.add_address' | t }}</h2>
        {%- form 'customer_address', customer.new_address, class: 'mt-6 grid gap-3' -%}
          {% render 'address-fields', form: form, prefix: 'new' %}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Account settings", "settings": [] }
{% endschema %}
