<div class="color-{{ section.settings.color_scheme }} bg-scheme">
<section class="grid min-h-screen place-items-center p-6"><div class="max-w-md text-center">
<h1 class="section-title">{{ shop.name }}</h1>{%- if shop.password_message != blank -%}<p class="section-sub mt-4">{{ shop.password_message }}</p>{%- endif -%}
{%- form 'storefront_password', class: 'mt-8 flex gap-2' -%}{{ form.errors | default_errors }}
<label for="Password" class="sr-only">{{ 'password.password' | t }}</label><input id="Password" type="password" name="password" class="h-12 flex-1 rounded-full border border-divider px-5" placeholder="{{ 'password.password' | t }}">
<button class="btn btn--primary">{{ 'password.enter' | t }}</button>{%- endform -%}
</div></section>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
