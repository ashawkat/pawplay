{%- if section.settings.show_banner -%}
  {% render 'page-banner', title: page.title, subtitle: section.settings.subtitle, breadcrumb: true, crumb: page.title %}
{%- endif -%}
{%- if page.content != blank -%}
  <section class="section-y">
    <div class="page-width max-w-[820px]">
      {%- unless section.settings.show_banner -%}<h1 class="section-title mb-8">{{ page.title }}</h1>{%- endunless -%}
      <div class="rte text-lg leading-relaxed text-muted [&_a]:text-primary [&_a]:underline [&_h2]:mb-3 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-semibold [&_li]:ml-6 [&_ul]:list-disc">{{ page.content }}</div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Show coral banner", "default": true },
    { "type": "richtext", "id": "subtitle", "label": "Banner subtitle" }
  ]
}
{% endschema %}
