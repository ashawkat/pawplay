{% render 'page-banner', title: section.settings.title, subtitle: section.settings.subtitle, breadcrumb: true %}
<section class="section-y">
  <div class="page-width">
    <ul class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
      {%- for collection in collections -%}
        <li>
          <a href="{{ collection.url }}" class="group block overflow-hidden rounded-3xl bg-white shadow-soft">
            <div class="aspect-square overflow-hidden bg-soft">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'size-full object-cover transition duration-500 group-hover:scale-105' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="flex items-center justify-between p-5">
              <span class="font-semibold text-ink">{{ collection.title }}</span>
              <span class="text-sm text-muted">{{ collection.products_count }}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by category" },
    { "type": "richtext", "id": "subtitle", "label": "Subtitle" }
  ]
}
{% endschema %}
