{%- comment -%} Figma: Auth (Sign In / create account) — split card {%- endcomment -%}
<section class="bg-blush py-12 md:py-20">
  <div class="page-width">
    <div class="grid overflow-hidden rounded-3xl bg-white shadow-soft lg:grid-cols-2">
      <div class="relative hidden min-h-[580px] bg-primary lg:block">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', class: 'absolute inset-0 size-full object-cover' }}
        {%- else -%}
          <span class="absolute inset-0 grid place-items-center text-white/20">{% render 'icon', name: 'paw', class: 'h-48 w-56' %}</span>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <p class="absolute inset-x-8 bottom-8 rounded-2xl bg-white/90 p-5 font-heading text-xl font-semibold text-ink backdrop-blur">{{ section.settings.quote }}</p>
        {%- endif -%}
      </div>
      <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
        <a href="{{ routes.root_url }}" class="mb-8 flex items-center gap-2 text-primary">{% render 'icon', name: 'paw', class: 'h-6 w-7' %}<span class="font-heading text-2xl font-bold"><span class="text-ink">Paw</span>Play</span></a>
        <h1 class="section-title">{{ 'customer.login' | t }}</h1>
        <p class="mt-2 text-muted">{{ 'customer.login_sub' | t }}</p>
        {%- form 'customer_login', class: 'mt-8 space-y-5' -%}
          {%- if form.errors -%}<div class="rounded-2xl bg-primary/10 p-4 text-sm text-primary" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          {% render 'field', name: 'customer[email]', label: 'customer.email', type: 'email', autocomplete: 'email', required: true %}
          {% render 'field', name: 'customer[password]', label: 'customer.password', type: 'password', autocomplete: 'current-password', required: true %}
          <div class="flex items-center justify-between text-sm">
            <span></span>
            <a href="#Recover" class="text-primary hover:underline" data-show-recover>{{ 'customer.forgot' | t }}</a>
          </div>
          <button class="btn btn--primary w-full">{{ 'customer.login' | t }}</button>
          <p class="text-center text-sm text-muted">{{ 'customer.no_account' | t }} <a href="{{ routes.account_register_url }}" class="font-semibold text-primary">{{ 'customer.register' | t }}</a></p>
        {%- endform -%}
        <div id="Recover" class="mt-10 hidden border-t border-divider pt-8 target:block">
          <h2 class="text-xl font-semibold">{{ 'customer.reset' | t }}</h2>
          {%- form 'recover_customer_password', class: 'mt-4 space-y-4' -%}
            {%- if form.posted_successfully? -%}<p class="text-sm text-secondary">{{ 'customer.recover_sent' | t }}</p>{%- endif -%}
            {{ form.errors | default_errors }}
            {% render 'field', name: 'email', label: 'customer.email', type: 'email', id: 'RecoverEmail', required: true %}
            <button class="btn w-full border border-divider bg-white text-ink">{{ 'customer.submit' | t }}</button>
          {%- endform -%}
        </div>
        {%- if shop.checkout.guest_login -%}
          <div class="mt-8 border-t border-divider pt-6">{%- form 'guest_login' -%}<button class="btn w-full border border-divider bg-white text-ink">{{ 'customer.guest' | t }}</button>{%- endform -%}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sign in",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote on image",
      "default": "Happy pets, happy humans."
    }
  ]
}
{% endschema %}
