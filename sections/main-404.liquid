{%- comment -%} Figma: PawPlay/ 404 (83:1006) {%- endcomment -%}
<section class="relative overflow-hidden bg-blush py-24 text-center md:py-32">
  <span class="pointer-events-none absolute left-[8%] top-[20%] text-primary/10" aria-hidden="true">{% render 'icon', name: 'paw', class: 'h-24 w-28 -rotate-12' %}</span>
  <span class="pointer-events-none absolute bottom-[15%] right-[10%] text-primary/10" aria-hidden="true">{% render 'icon', name: 'paw', class: 'h-28 w-32 rotate-12' %}</span>
  <div class="page-width relative">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 900 | image_tag: class: 'mx-auto h-auto w-full max-w-[420px]' }}
    {%- else -%}
      <p class="font-heading text-[120px] font-bold leading-none text-primary md:text-[200px]">4<span class="inline-block align-middle text-ink">{% render 'icon', name: 'paw', class: 'h-[0.6em] w-[0.7em]' %}</span>4</p>
    {%- endif -%}
    <h1 class="section-title mt-6">{{ section.settings.heading }}</h1>
    <p class="section-sub mx-auto mt-3 max-w-[520px]">{{ section.settings.text }}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'templates.404.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--light">{{ 'templates.404.cta' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Oops! This page wandered off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Looks like this pup chased a squirrel. Let’s get you back on track." }
  ]
}
{% endschema %}
