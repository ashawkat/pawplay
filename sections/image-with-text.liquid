<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Figma: "Designed for adventures together" full-bleed banner. Reusable anywhere. {%- endcomment -%}
<section class="relative isolate overflow-hidden" style="background: {{ section.settings.background }};">
  {%- if section.settings.layout == 'cover' and section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800,1200,1600,2400', class: 'absolute inset-0 -z-10 size-full object-cover' }}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[color:var(--pp-primary)]/90 via-[color:var(--pp-primary)]/40 to-transparent"></div>
  {%- endif -%}
  <div class="page-width grid min-h-[420px] items-center gap-10 py-16 md:min-h-[540px] {% if section.settings.layout != 'cover' %}md:grid-cols-2{% endif %}">
    <div class="max-w-[480px] {% if section.settings.layout == 'image_left' %}md:order-2{% endif %}">
      <h2 class="font-heading text-4xl font-bold leading-tight md:text-5xl" style="color: {{ section.settings.text_color }};">{{ section.settings.heading }}</h2>
      <div class="rte mt-4 text-lg font-medium md:text-xl" style="color: {{ section.settings.text_color | color_modify: 'alpha', 0.85 }};">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--yellow mt-8">{{ section.settings.button_label }}{% render 'icon', name: 'arrow-right', class: 'size-5' %}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.layout != 'cover' -%}
      <div class="overflow-hidden rounded-3xl {% if section.settings.layout == 'image_left' %}md:order-1{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'w-full h-auto' }}
        {%- else -%}
          <div class="aspect-[4/3]">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Full-bleed image"
        },
        {
          "value": "image_right",
          "label": "Image right"
        },
        {
          "value": "image_left",
          "label": "Image left"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for adventures together"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lightweight comfort, breathable ventilation, and a paw-print finish that turns heads.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FF8A80"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
