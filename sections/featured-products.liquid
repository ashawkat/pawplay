<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Figma: Frame 105 (37:301) — "Loved by Pets" product grid {%- endcomment -%}
<section class="section-y">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}

    {%- assign collection = section.settings.collection -%}
    <ul class="mt-14 grid grid-cols-2 gap-4 md:gap-6 lg:grid-cols-4">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="mt-6 flex justify-center">
        <a href="{{ section.settings.button_link | default: collection.url | default: routes.all_products_collection_url }}" class="btn border border-divider bg-card text-ink">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Pets. Trusted by Owners."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Carefully selected pet essentials that deliver taste, nutrition, and happiness—every single day."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore All Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the selected collection"
    },
    {
      "type": "paragraph",
      "content": "Ratings use the reviews.rating metafield (Shopify Product Reviews standard). Badge text uses custom.badge."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
