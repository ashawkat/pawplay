<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Latest posts row — usable on home, about, article pages {%- endcomment -%}
<section class="section-y">
  <div class="page-width">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, subheading: section.settings.subheading %}
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: 3 -%}<li>{% render 'article-card', article: article %}</li>{%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}<li>{% render 'article-card' %}</li>{%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tips for happy pets"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}
