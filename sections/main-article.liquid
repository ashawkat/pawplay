<article class="section-y">
  <div class="page-width max-w-[820px]">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="{{ blog.url }}" class="hover:text-primary">{{ blog.title }}</a> / <span aria-current="page">{{ article.title }}</span></nav>
    <h1 class="section-title mt-4 md:text-5xl">{{ article.title }}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted">
      {%- if section.settings.show_author -%}<span>{{ article.author }}</span> ·{%- endif -%}
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
      {%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{{ tag }}</a>{%- endfor -%}
    </div>
  </div>
  {%- if article.image -%}
    <div class="page-width mt-10 max-w-[1140px]">
      <div class="overflow-hidden rounded-3xl">{{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '800,1200,1600,2000', class: 'w-full h-auto' }}</div>
    </div>
  {%- endif -%}
  <div class="page-width mt-10 max-w-[820px]">
    <div class="rte text-lg leading-relaxed text-muted [&_a]:text-primary [&_a]:underline [&_blockquote]:border-l-4 [&_blockquote]:border-primary [&_blockquote]:pl-5 [&_blockquote]:italic [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-3xl [&_h2]:font-semibold [&_h3]:mb-2 [&_h3]:mt-8 [&_h3]:text-2xl [&_img]:rounded-2xl [&_li]:ml-6 [&_ol]:list-decimal [&_ul]:list-disc">{{ article.content }}</div>

    {%- if section.settings.show_share -%}
      <div class="mt-10 flex items-center gap-3 border-t border-divider pt-6 text-sm font-semibold">
        {{ 'blogs.share' | t }}
        <a class="grid size-9 place-items-center rounded-full bg-soft hover:bg-primary hover:text-white" target="_blank" rel="noopener" href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url | url_encode }}" aria-label="Facebook">{% render 'icon', name: 'facebook', class: 'size-4' %}</a>
        <a class="grid size-9 place-items-center rounded-full bg-soft hover:bg-primary hover:text-white" target="_blank" rel="noopener" href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: article.url | url_encode }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest', class: 'size-4' %}</a>
        <a class="grid size-9 place-items-center rounded-full bg-soft hover:bg-primary hover:text-white" target="_blank" rel="noopener" href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url | append: article.url | url_encode }}" aria-label="LinkedIn">{% render 'icon', name: 'linkedin', class: 'size-4' %}</a>
      </div>
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <div class="mt-12">
        <h2 class="text-2xl font-semibold">{{ 'blogs.comments' | t: count: article.comments_count }}</h2>
        <ul class="mt-6 space-y-4">
          {%- for comment in article.comments -%}
            <li class="rounded-2xl bg-soft p-5"><p class="text-sm font-semibold">{{ comment.author }} · <span class="font-normal text-muted">{{ comment.created_at | date: format: 'date' }}</span></p><div class="mt-2 text-muted">{{ comment.content }}</div></li>
          {%- endfor -%}
        </ul>
        {%- form 'new_comment', article, class: 'mt-8 grid gap-4 sm:grid-cols-2' -%}
          {%- if form.posted_successfully? -%}<p class="text-sm text-secondary sm:col-span-2">{{ 'blogs.comment_posted' | t }}</p>{%- endif -%}
          {{ form.errors | default_errors }}
          {% render 'field', name: 'comment[author]', label: 'contact.name', required: true, value: form.author %}
          {% render 'field', name: 'comment[email]', label: 'contact.email', type: 'email', required: true, value: form.email %}
          <label class="block sm:col-span-2"><span class="mb-2 block text-sm font-semibold">{{ 'contact.message' | t }}</span><textarea name="comment[body]" rows="4" required class="w-full rounded-2xl border border-divider bg-soft p-4">{{ form.body }}</textarea></label>
          <button class="btn btn--primary w-fit">{{ 'blogs.post_comment' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Blog post",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true }
  ]
}
{% endschema %}
