<div class="color-{{ section.settings.color_scheme }} bg-scheme">
<section class=" py-12 md:py-16">
  <div class="page-width grid gap-6 lg:grid-cols-[260px_1fr]">
    {% render 'account-nav', active: 'orders' %}
    <div class="space-y-6">
      <div class="rounded-3xl bg-card p-6 shadow-soft">
        <a href="{{ routes.account_url }}#orders" class="text-sm text-primary">← {{ 'customer.orders' | t }}</a>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <h1 class="font-heading text-3xl font-bold text-ink">{{ order.name }}</h1>
          <div class="flex gap-2 text-xs font-semibold">
            <span class="rounded-full bg-soft px-3 py-1">{{ order.financial_status_label }}</span>
            <span class="rounded-full bg-yellow/40 px-3 py-1">{{ order.fulfillment_status_label }}</span>
          </div>
        </div>
        <p class="text-sm text-muted">{{ order.created_at | date: format: 'date_at_time' }}</p>
        {%- if order.cancelled -%}<p class="mt-3 rounded-xl bg-primary/10 p-3 text-sm text-primary">{{ 'customer.cancelled' | t }} {{ order.cancelled_at | date: format: 'date' }}</p>{%- endif -%}

        <ul class="mt-6 divide-y divide-divider">
          {%- for li in order.line_items -%}
            <li class="flex items-center gap-4 py-4">
              <span class="size-16 shrink-0 overflow-hidden rounded-xl bg-[#f3f3f3]">{%- if li.image -%}{{ li.image | image_url: width: 140 | image_tag: class: 'size-full object-contain' }}{%- endif -%}</span>
              <div class="flex-1">
                <a href="{{ li.url }}" class="font-semibold text-ink">{{ li.title }}</a>
                <p class="text-sm text-muted">{{ li.final_price | money }} × {{ li.quantity }}</p>
                {%- if li.fulfillment -%}<p class="text-xs text-secondary">{{ li.fulfillment.created_at | date: format: 'date' }}{% if li.fulfillment.tracking_url %} · <a href="{{ li.fulfillment.tracking_url }}" class="underline" target="_blank" rel="noopener">{{ 'customer.track' | t }}</a>{% endif %}</p>{%- endif -%}
              </div>
              <span class="font-bold text-primary">{{ li.final_line_price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <dl class="ml-auto mt-4 max-w-xs space-y-2 border-t border-divider pt-4 text-sm">
          <div class="flex justify-between"><dt>{{ 'templates.cart.subtotal' | t }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
          {%- for d in order.cart_level_discount_applications -%}<div class="flex justify-between text-secondary"><dt>{{ d.title }}</dt><dd>-{{ d.total_allocated_amount | money }}</dd></div>{%- endfor -%}
          {%- for s in order.shipping_methods -%}<div class="flex justify-between"><dt>{{ s.title }}</dt><dd>{{ s.price | money }}</dd></div>{%- endfor -%}
          {%- for t in order.tax_lines -%}<div class="flex justify-between"><dt>{{ t.title }} ({{ t.rate_percentage }}%)</dt><dd>{{ t.price | money }}</dd></div>{%- endfor -%}
          <div class="flex justify-between border-t border-divider pt-2 text-lg font-bold"><dt>{{ 'templates.cart.total' | t }}</dt><dd class="text-primary">{{ order.total_price | money_with_currency }}</dd></div>
        </dl>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-3xl bg-card p-6 shadow-soft"><h2 class="font-semibold text-ink">{{ 'customer.billing' | t }}</h2><div class="mt-3 text-sm text-muted">{{ order.billing_address | format_address }}</div></div>
        <div class="rounded-3xl bg-card p-6 shadow-soft"><h2 class="font-semibold text-ink">{{ 'customer.shipping' | t }}</h2><div class="mt-3 text-sm text-muted">{{ order.shipping_address | format_address }}</div></div>
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Order",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
