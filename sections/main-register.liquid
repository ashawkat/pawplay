<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Figma: Auth (Sign In / create account) — split card {%- endcomment -%}
<section class=" py-12 md:py-20">
  <div class="page-width">
    <div class="grid overflow-hidden rounded-3xl bg-card shadow-soft lg:grid-cols-2">
      <div class="relative hidden min-h-[580px] bg-primary lg:block">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'eager', class: 'absolute inset-0 size-full object-cover' }}
        {%- else -%}
          <span class="absolute inset-0 grid place-items-center text-white/20">{% render 'icon', name: 'paw', class: 'h-48 w-56' %}</span>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <p class="absolute inset-x-8 bottom-8 rounded-2xl bg-white/90 p-5 font-heading text-xl font-semibold text-ink backdrop-blur">{{ section.settings.quote }}</p>
        {%- endif -%}
      </div>
      <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
        <a href="{{ routes.root_url }}" class="mb-8 flex items-center gap-2 text-primary">{% render 'icon', name: 'paw', class: 'h-6 w-7' %}<span class="font-heading text-2xl font-bold"><span class="text-ink">Paw</span>Play</span></a>
        <h1 class="section-title">{{ 'customer.register' | t }}</h1>
        <p class="mt-2 text-muted">{{ 'customer.register_sub' | t }}</p>
        {%- form 'create_customer', class: 'mt-8 space-y-5' -%}
          {%- if form.errors -%}<div class="rounded-2xl bg-primary/10 p-4 text-sm text-primary" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="grid gap-4 sm:grid-cols-2">
          {% render 'field', name: 'customer[first_name]', label: 'customer.first_name', type: 'text', autocomplete: 'given-name' %}
          {% render 'field', name: 'customer[last_name]', label: 'customer.last_name', type: 'text', autocomplete: 'family-name' %}
          </div>
          {% render 'field', name: 'customer[email]', label: 'customer.email', type: 'email', autocomplete: 'email', required: true %}
          {% render 'field', name: 'customer[password]', label: 'customer.password', type: 'password', autocomplete: 'new-password', required: true %}
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="customer[accepts_marketing]" class="accent-[var(--pp-primary)]"> {{ 'customer.marketing' | t }}</label>
          <button class="btn btn--primary w-full">{{ 'customer.register' | t }}</button>
          <p class="text-center text-sm text-muted">{{ 'customer.have_account' | t }} <a href="{{ routes.account_login_url }}" class="font-semibold text-primary">{{ 'customer.login' | t }}</a></p>
        {%- endform -%}

      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Create account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote on image",
      "default": "Happy pets, happy humans."
    }
  ]
}
{% endschema %}
