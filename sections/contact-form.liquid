<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Contact page: info cards + Shopify contact form (emails the store) + optional map {%- endcomment -%}
<section class="section-y">
  <div class="page-width grid gap-10 lg:grid-cols-[400px_1fr]">
    <div class="space-y-4">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <div class="rte text-lg text-muted">{{ section.settings.text }}</div>
      <ul class="space-y-3 pt-4">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }} class="flex items-center gap-4 rounded-2xl border border-divider bg-card p-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl text-white" style="background: {{ block.settings.color }};">{% render 'icon', name: block.settings.icon, class: 'size-6' %}</span>
            <div>
              <p class="text-sm text-muted">{{ block.settings.label }}</p>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="font-semibold text-ink hover:text-primary">{{ block.settings.value }}</a>
              {%- else -%}
                <p class="font-semibold text-ink">{{ block.settings.value }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="rounded-3xl bg-card p-6 shadow-soft md:p-10">
      {%- form 'contact', id: 'ContactForm', class: 'grid gap-5 sm:grid-cols-2' -%}
        {%- if form.posted_successfully? -%}
          <p class="rounded-2xl bg-secondary/15 p-4 text-sm font-medium text-ink sm:col-span-2" role="status">{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="rounded-2xl bg-primary/10 p-4 text-sm text-primary sm:col-span-2" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {% render 'field', name: 'contact[name]', label: 'contact.name', autocomplete: 'name', value: customer.name %}
        {% render 'field', name: 'contact[email]', label: 'contact.email', type: 'email', autocomplete: 'email', required: true, value: customer.email %}
        {% render 'field', name: 'contact[phone]', label: 'contact.phone', type: 'tel', autocomplete: 'tel', full: true %}
        <label class="block sm:col-span-2">
          <span class="mb-2 block text-sm font-semibold text-text">{{ 'contact.message' | t }}</span>
          <textarea name="contact[body]" rows="6" required class="w-full rounded-2xl border border-divider bg-soft p-4 outline-none focus:border-primary">{{ form.body }}</textarea>
        </label>
        <button type="submit" class="btn btn--primary sm:col-span-2 sm:w-fit">{{ 'contact.send' | t }}{% render 'icon', name: 'arrow-right', class: 'size-5' %}</button>
      {%- endform -%}
    </div>
  </div>

  {%- if section.settings.map_query != blank -%}
    <div class="page-width mt-12">
      <iframe title="Map" loading="lazy" class="h-[360px] w-full rounded-3xl border-0" referrerpolicy="no-referrer-when-downgrade"
        src="https://maps.google.com/maps?q={{ section.settings.map_query | url_encode }}&output=embed"></iframe>
    </div>
  {%- endif -%}
</section>
</div>

{% schema %}
{
  "name": "Contact form",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We’d love to hear from you"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions about an order, a product or booking a service? Our friendly team usually replies within a few hours.</p>"
    },
    {
      "type": "text",
      "id": "map_query",
      "label": "Map address",
      "info": "Shows an embedded Google map when filled",
      "default": "218 Maple Avenue"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "phone",
          "options": [
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "pin",
              "label": "Location"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "shield",
              "label": "Clock/Shield"
            }
          ]
        },
        {
          "type": "color",
          "id": "color",
          "label": "Icon background",
          "default": "#FF6B6B"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Call us"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "+155 5467 2345"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        {
          "type": "info"
        },
        {
          "type": "info",
          "settings": {
            "icon": "chat",
            "color": "#4ECDC4",
            "label": "Email us",
            "value": "hello@example.com"
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "pin",
            "color": "#F4C430",
            "label": "Visit us",
            "value": "218 Maple avenue, Downtown"
          }
        }
      ]
    }
  ]
}
{% endschema %}
