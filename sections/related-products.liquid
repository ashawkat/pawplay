<div class="color-{{ section.settings.color_scheme }} bg-scheme">
{%- comment -%} Figma: "PawPlay picks for your pet" — Shopify product recommendations {%- endcomment -%}
<product-recommendations class="block section-y" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="flex items-end justify-between gap-4">
        <h2 class="section-title text-2xl md:text-3xl">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="font-medium text-primary underline">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
      <ul class="scroll-row mt-8 pb-4">
        {%- for product in recommendations.products -%}
          <li class="w-[266px]">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>
</div>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PawPlay picks for your pet"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
