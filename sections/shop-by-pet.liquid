{%- comment -%} Figma: Frame 110 (46:245) — category tiles + promo banners {%- endcomment -%}
<section class="section-y overflow-hidden">
  <div class="page-width">
    <div class="flex items-end justify-between gap-6">
      <div class="relative">
        <span class="absolute -top-8 left-[180px] hidden text-primary md:block">{% render 'icon', name: 'scribble', class: 'h-12 w-16' %}</span>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="mt-2.5 text-lg font-medium text-muted md:text-2xl">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      <div class="hidden gap-2.5 md:flex">
        <button type="button" class="grid size-11 place-items-center rounded-full border border-ink text-ink disabled:border-divider disabled:text-disabled" data-scroll-prev="ShopByPet-{{ section.id }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', class: 'size-6' %}</button>
        <button type="button" class="grid size-11 place-items-center rounded-full border border-ink text-ink disabled:border-divider disabled:text-disabled" data-scroll-next="ShopByPet-{{ section.id }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', class: 'size-6' %}</button>
      </div>
    </div>

    {%- assign tiles = section.blocks | where: 'type', 'category' -%}
    <ul id="ShopByPet-{{ section.id }}" class="scroll-row mt-16 pt-16 md:mt-[100px]">
      {%- for block in tiles -%}
        {%- assign c = block.settings.color -%}
        <li {{ block.shopify_attributes }} class="w-[273px]">
          <a href="{{ block.settings.collection.url | default: '#' }}" class="group relative flex h-[180px] flex-col items-center justify-end gap-6 rounded-xl px-6 pb-6" style="background: {{ c | color_modify: 'alpha', 0.14 }}; --tile: {{ c }};">
            <div class="absolute bottom-[96px] left-1/2 h-[190px] w-[199px] -translate-x-1/2">
              <span class="absolute bottom-0 left-[3.5px] h-[142px] w-[192px] rounded-b-3xl rounded-t-[100px]" style="background: var(--tile);"></span>
              <div class="absolute inset-0 overflow-hidden rounded-b-3xl rounded-t-[100px]">
                {%- assign img = block.settings.image | default: block.settings.collection.featured_image -%}
                {%- if img != blank -%}
                  {{ img | image_url: width: 400 | image_tag: loading: 'lazy', class: 'size-full object-cover object-top transition duration-500 group-hover:scale-105', alt: block.settings.title }}
                {%- endif -%}
              </div>
            </div>
            <span class="text-2xl font-semibold leading-none text-text">{{ block.settings.title | default: block.settings.collection.title }}</span>
            <span class="flex items-center gap-2.5 font-medium leading-[1.3]" style="color: var(--tile);">{{ block.settings.link_label }}{% render 'icon', name: 'arrow-right', class: 'size-4' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- assign promos = section.blocks | where: 'type', 'promo' -%}
    {%- if promos.size > 0 -%}
      <div class="mt-12 grid gap-[26px] md:grid-cols-2">
        {%- for block in promos -%}
          {%- liquid
            assign style = block.settings.style
            if style == 'green'
              assign bg = '#96ddbc'
            else
              assign bg = block.settings.background
            endif
          -%}
          <div {{ block.shopify_attributes }} class="relative isolate h-[260px] overflow-hidden rounded-2xl" style="background: {{ bg }};">
            {%- if block.settings.image != blank -%}
              {%- if style == 'green' -%}
                <div class="absolute inset-y-0 right-0 -z-10 w-[60%]">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'size-full object-cover' }}</div>
                <div class="absolute inset-0 -z-10" style="background: linear-gradient(234deg, rgb(160 226 193 / 0) 5%, #23b96f 62%);"></div>
              {%- else -%}
                <div class="absolute bottom-0 right-0 -z-10 h-[92%] w-[62%]">{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'size-full object-contain object-right-bottom' }}</div>
              {%- endif -%}
            {%- endif -%}
            <div class="flex h-full max-w-[300px] flex-col p-7">
              {%- if block.settings.eyebrow != blank -%}
                <p class="font-medium text-white [&_strong]:font-heading [&_strong]:text-4xl [&_strong]:font-semibold [&_strong]:text-yellow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              <h3 class="mt-1 text-[28px] font-semibold leading-tight {% if style == 'green' %}font-body text-[32px] font-bold text-white/95{% else %}text-yellow{% endif %}">{{ block.settings.title }}</h3>
              <p class="mt-2 text-base font-medium leading-[1.2] text-white/85">{{ block.settings.text }}</p>
              {%- if block.settings.price_label != blank -%}
                <p class="mt-auto flex items-baseline gap-2 text-white/95"><span class="font-semibold">{{ block.settings.price_label }}</span><span class="text-2xl font-bold">{{ block.settings.price }}</span></p>
              {%- endif -%}
              <a href="{{ block.settings.link | default: '#' }}" class="btn btn--yellow mt-auto h-10 w-fit px-3 pl-4 text-base">
                {{ block.settings.button_label }}{% render 'icon', name: 'arrow-right-circle', class: 'size-[21px]' %}
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by pet",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Pet" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Carefully curated essentials for every kind of companion." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to collection title" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Cut-out PNG, 400 × 380px" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop Essentials" },
        { "type": "color", "id": "color", "label": "Tile color", "default": "#FF6B6B" }
      ]
    },
    {
      "type": "promo",
      "name": "Promo banner",
      "limit": 2,
      "settings": [
        { "type": "select", "id": "style", "label": "Style", "default": "solid", "options": [ { "value": "green", "label": "Green gradient" }, { "value": "solid", "label": "Solid color" } ] },
        { "type": "color", "id": "background", "label": "Background (solid style)", "default": "#FF6B6B" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "inline_richtext", "id": "eyebrow", "label": "Eyebrow", "info": "Bold text is highlighted large" },
        { "type": "text", "id": "title", "label": "Title", "default": "Parrot Food" },
        { "type": "text", "id": "text", "label": "Text", "default": "Nutritious blends for vibrant feathers and active days." },
        { "type": "text", "id": "price_label", "label": "Price label", "default": "Starts from" },
        { "type": "text", "id": "price", "label": "Price", "default": "$5.00" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by pet",
      "blocks": [
        { "type": "category", "settings": { "title": "Dog food", "link_label": "Shop Dog Essentials", "color": "#FF6B6B" } },
        { "type": "category", "settings": { "title": "Cat Food", "link_label": "Shop Cat Essentials", "color": "#4ECDC4" } },
        { "type": "category", "settings": { "title": "Bird Food", "link_label": "Shop Bird Essentials", "color": "#F4C430" } },
        { "type": "category", "settings": { "title": "Accessories", "link_label": "Browse Accessories", "color": "#B682FF" } },
        { "type": "promo", "settings": { "style": "green", "eyebrow": "Up to <strong>50%</strong> Discount", "title": "Food & Accessories", "price_label": "", "price": "" } },
        { "type": "promo", "settings": { "style": "solid" } }
      ]
    }
  ]
}
{% endschema %}
