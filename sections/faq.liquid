{%- comment -%} Figma: Frame 109 (41:261) {%- endcomment -%}
<section class="section-y">
  <div class="page-width grid gap-12 lg:grid-cols-[357px_1fr]">
    <div class="relative">
      <h2 class="section-title max-w-[300px]">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="mt-2.5 text-xl font-semibold leading-[1.3] text-muted">{{ section.settings.subheading }}</p>{%- endif -%}
      <span class="mt-10 hidden text-[#ffe9d0] lg:block">{% render 'icon', name: 'paw', class: 'h-48 w-56 rotate-12' %}</span>
    </div>
    <div class="space-y-[15px]">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }} class="group rounded-2xl border border-divider open:bg-soft" {% if forloop.first and section.settings.open_first %}open{% endif %}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-lg font-semibold text-text md:text-xl [&::-webkit-details-marker]:hidden">
            {{ block.settings.question }}
            {% render 'icon', name: 'chevron-down', class: 'size-6 shrink-0 transition group-open:rotate-180' %}
          </summary>
          <div class="rte px-4 pb-4 text-base font-medium leading-[1.3] text-muted md:text-lg">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} FAQ structured data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Everything you need to know about our products, orders, and pet care." },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are your pet food products safe and high quality?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. All our pet food products are made using carefully selected ingredients and follow strict quality and safety standards to ensure your pet’s well-being.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Do you offer food for different types of pets?", "answer": "<p>Yes — we stock food for dogs, cats, birds and small pets.</p>" } },
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Most orders arrive within 2–5 business days.</p>" } },
        { "type": "question", "settings": { "question": "Do you offer free shipping?", "answer": "<p>Yes, on orders over $25.</p>" } },
        { "type": "question", "settings": { "question": "Can I return or exchange a product?", "answer": "<p>Unopened items can be returned within 30 days.</p>" } },
        { "type": "question", "settings": { "question": "How can I contact customer support?", "answer": "<p>Reach us through the contact page or by phone.</p>" } }
      ]
    }
  ]
}
{% endschema %}
