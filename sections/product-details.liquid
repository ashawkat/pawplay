{%- comment -%} Figma: "Everything you need to know" accordion {%- endcomment -%}
<section class="section-y">
  <div class="page-width max-w-[980px]">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
    <div class="mt-10 space-y-4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign body = block.settings.content
          if block.type == 'description'
            assign body = product.description
          elsif block.settings.page != blank
            assign body = block.settings.page.content
          endif
        -%}
        {%- if body != blank or request.design_mode -%}
          <details {{ block.shopify_attributes }} class="group rounded-2xl border border-divider open:bg-soft" {% if forloop.first %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-semibold text-text [&::-webkit-details-marker]:hidden">
              {{ block.settings.heading }}{% render 'icon', name: 'chevron-down', class: 'size-6 shrink-0 transition group-open:rotate-180' %}
            </summary>
            <div class="rte px-5 pb-5 leading-relaxed text-muted [&_li]:ml-5 [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-1.5">{{ body }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Product Details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need to know" }
  ],
  "blocks": [
    { "type": "description", "name": "Description", "limit": 1, "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Description" } ] },
    {
      "type": "tab", "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Material & Care" },
        { "type": "richtext", "id": "content", "label": "Content", "info": "Connect a product metafield to make this per-product" },
        { "type": "page", "id": "page", "label": "Or show content from a page" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "description" },
        { "type": "tab", "settings": { "heading": "Material & Care" } },
        { "type": "tab", "settings": { "heading": "Size & Fit" } },
        { "type": "tab", "settings": { "heading": "Shipping & Returns" } }
      ]
    }
  ]
}
{% endschema %}
