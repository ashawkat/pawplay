<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }}</title>
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
-%}
<style>{{ body_font | font_face: font_display: 'swap' }}{{ heading_font | font_face: font_display: 'swap' }}
{% render 'color-schemes' %}:root{--pp-warning:{{ settings.color_warning }};--pp-font-heading:{{ heading_font.family }},{{ heading_font.fallback_families }};--pp-font-body:{{ body_font.family }},{{ body_font.fallback_families }};}</style>
{{ 'app.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body>{{ content_for_layout }}</body></html>
