<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }}</title>
{%- liquid
  assign heading_font = settings.type_heading_font
  assign body_font = settings.type_body_font
-%}
<style>{{ body_font | font_face: font_display: 'swap' }}{{ heading_font | font_face: font_display: 'swap' }}
:root{--pp-primary:{{ settings.color_primary }};--pp-secondary:{{ settings.color_secondary }};--pp-yellow:{{ settings.color_yellow }};--pp-warning:{{ settings.color_warning }};--pp-info:{{ settings.color_info }};--pp-black:{{ settings.color_heading }};--pp-text:{{ settings.color_text }};--pp-text-muted:{{ settings.color_text_muted }};--pp-hero-bg:{{ settings.color_hero_bg }};--pp-cream:{{ settings.color_cream }};--pp-footer-bg:{{ settings.color_footer_bg }};--pp-font-heading:{{ heading_font.family }},{{ heading_font.fallback_families }};--pp-font-body:{{ body_font.family }},{{ body_font.fallback_families }};}</style>
{{ 'app.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body>{{ content_for_layout }}</body></html>
