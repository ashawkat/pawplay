{%- comment -%} Figma: blog card (255:1944). Params: article {%- endcomment -%}
<article class="group flex h-full flex-col overflow-hidden rounded-3xl bg-card shadow-soft">
  <a href="{{ article.url | default: '#' }}" class="block aspect-[364/240] overflow-hidden" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 1024px) 364px, 100vw', class: 'size-full object-cover transition duration-500 group-hover:scale-105', alt: article.image.alt | default: article.title }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex flex-wrap items-center gap-3 text-sm text-muted">
      {%- if article.tags.first -%}<span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">{{ article.tags.first }}</span>{%- endif -%}
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
    </div>
    <h3 class="font-body text-xl font-bold leading-snug text-text"><a href="{{ article.url | default: '#' }}" class="hover:text-primary">{{ article.title | default: 'Blog post title' }}</a></h3>
    <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
    <a href="{{ article.url | default: '#' }}" class="mt-auto flex items-center gap-1.5 pt-2 font-medium text-primary">{{ 'blogs.read_more' | t }}{% render 'icon', name: 'arrow-right', class: 'size-4' %}<span class="sr-only">: {{ article.title }}</span></a>
  </div>
</article>
