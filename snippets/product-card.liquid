{%- comment -%}
  Figma: product (19:95)
  Params: product (optional — renders placeholder when blank)
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
  assign rating = product.metafields.reviews.rating.value.rating | default: 0
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign badge = product.metafields.custom.badge.value
-%}
<article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-[0_0_0_1px_#f3f3f3] transition hover:shadow-soft">
  <div class="relative aspect-[266/219] overflow-hidden bg-[#f3f3f3]">
    <a href="{{ product.url | default: '#' }}" class="block size-full" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 1024px) 266px, 50vw', class: 'mx-auto h-[86%] w-auto object-contain translate-y-[8%] transition duration-500 group-hover:scale-105', alt: product.featured_media.alt | default: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    {%- if badge != blank -%}
      <span class="absolute left-3 top-3 grid h-[30px] place-items-center rounded-xl bg-yellow px-2.5 text-sm font-medium text-ink">{{ badge }}</span>
    {%- elsif on_sale -%}
      <span class="absolute left-3 top-3 grid h-[30px] place-items-center rounded-xl bg-primary px-2.5 text-sm font-medium text-white">-{{ discount }}%</span>
    {%- endif -%}

    {%- if product.available -%}
      <div class="absolute inset-x-0 bottom-0 flex h-9 translate-y-full items-center justify-center gap-2.5 bg-primary text-sm font-medium text-white transition duration-300 group-hover:translate-y-0 group-focus-within:translate-y-0">
        {%- form 'product', product, class: 'contents', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="flex items-center gap-1.5 {% if settings.show_wishlist_button %}border-r border-white/30 pr-2.5{% endif %}">
            {% render 'icon', name: 'bag', class: 'size-3.5' %}{{ 'products.add_to_cart' | t }}
          </button>
        {%- endform -%}
        {%- if settings.show_wishlist_button -%}
          <button type="button" class="flex items-center gap-1.5" data-wishlist="{{ product.handle }}">
            {% render 'icon', name: 'heart', class: 'size-3.5' %}{{ 'products.add_to_wishlist' | t }}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="flex flex-1 flex-col items-center gap-4 p-4 text-center">
    <h3 class="font-body text-base font-semibold leading-snug text-text">
      <a href="{{ product.url | default: '#' }}" class="after:absolute after:inset-0 relative">{{ product.title | default: 'Product title' }}</a>
    </h3>
    {%- if rating_count > 0 -%}
      <div class="flex items-center gap-2.5" aria-label="{{ 'accessibility.star_rating' | t: rating: rating }}">
        <div class="flex gap-0.5">
          {%- for i in (1..5) -%}
            {%- if i <= rating -%}{% render 'icon', name: 'star', class: 'size-[18px] text-warning' %}{%- else -%}{% render 'icon', name: 'star', class: 'size-[18px] text-[#d9d9d9]' %}{%- endif -%}
          {%- endfor -%}
        </div>
        <span class="text-sm font-medium text-disabled">({{ rating_count }})</span>
      </div>
    {%- endif -%}
    <div class="mt-auto flex items-center gap-2.5 text-base">
      {%- if on_sale -%}
        <s class="font-medium text-[#b6b6b6]"><span class="sr-only">{{ 'products.regular_price' | t }}</span>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      <span class="font-bold text-primary">{% if on_sale %}<span class="sr-only">{{ 'products.sale_price' | t }}</span>{% endif %}{{ product.price | default: 2999 | money }}</span>
    </div>
  </div>
</article>
