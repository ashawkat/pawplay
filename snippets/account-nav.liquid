{%- comment -%}
  Figma: Profile sidebar. Params: active ('overview'|'pets'|'orders'|'bookings'|'wishlist'|'settings')
  Pets/Bookings/Wishlist live on pages using the page.my-pets / page.bookings / page.wishlist templates.
{%- endcomment -%}
{%- liquid
  assign items = 'overview,pets,orders,bookings,wishlist,settings' | split: ','
-%}
<aside class="h-fit rounded-3xl bg-white p-5 shadow-soft lg:sticky lg:top-32">
  {%- if customer -%}
    <div class="mb-5 flex items-center gap-3 border-b border-divider pb-5">
      <span class="grid size-12 place-items-center rounded-full bg-primary font-heading text-lg font-bold text-white">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</span>
      <div class="min-w-0">
        <p class="truncate font-semibold text-ink">{{ customer.name | default: customer.email }}</p>
        <p class="truncate text-sm text-muted">{{ customer.email }}</p>
      </div>
    </div>
  {%- endif -%}
  <nav aria-label="{{ 'customer.account' | t }}">
    <ul class="flex gap-1 overflow-x-auto lg:flex-col">
      {%- for item in items -%}
        {%- liquid
          case item
            when 'overview'
              assign url = routes.account_url
              assign icon = 'user'
            when 'pets'
              assign url = '/pages/my-pets'
              assign icon = 'paw'
            when 'orders'
              assign url = routes.account_url | append: '#orders'
              assign icon = 'bag'
            when 'bookings'
              assign url = '/pages/bookings'
              assign icon = 'shield'
            when 'wishlist'
              assign url = '/pages/wishlist'
              assign icon = 'heart'
            when 'settings'
              assign url = routes.account_addresses_url
              assign icon = 'pin'
          endcase
          assign key = 'customer.nav_' | append: item
        -%}
        <li class="shrink-0">
          <a href="{{ url }}" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition {% if active == item %}bg-primary text-white{% else %}text-text hover:bg-soft{% endif %}" {% if active == item %}aria-current="page"{% endif %}>
            {% render 'icon', name: icon, class: 'size-4' %}{{ key | t }}
          </a>
        </li>
      {%- endfor -%}
      <li class="shrink-0 lg:mt-3 lg:border-t lg:border-divider lg:pt-3">
        <a href="{{ routes.account_logout_url }}" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-primary hover:bg-primary/5">{% render 'icon', name: 'close', class: 'size-4' %}{{ 'customer.logout' | t }}</a>
      </li>
    </ul>
  </nav>
</aside>
