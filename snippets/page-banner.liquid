{%- comment -%}
  Coral page banner with breadcrumb (Figma: Shop / About headers)
  Params: title, subtitle, breadcrumb (bool), image (optional bg image)
{%- endcomment -%}
<div class="relative isolate overflow-hidden bg-primary">
  {%- if image != blank -%}
    {{ image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'absolute inset-0 -z-20 size-full object-cover opacity-30', alt: '' }}
  {%- endif -%}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-[-60%] h-[140%] w-[70%] -translate-x-1/2 rounded-[50%] bg-[#ff4d4d]/40 blur-[80px]"></div>
    <span class="absolute left-[4%] top-[18%] text-white/15">{% render 'icon', name: 'paw', class: 'h-12 w-14 -rotate-12' %}</span>
    <span class="absolute left-[14%] bottom-[12%] text-white/15">{% render 'icon', name: 'paw', class: 'h-10 w-12 rotate-12' %}</span>
    <span class="absolute right-[8%] top-[14%] text-white/15">{% render 'icon', name: 'paw', class: 'h-14 w-16 rotate-6' %}</span>
    <span class="absolute right-[18%] bottom-[10%] text-white/15">{% render 'icon', name: 'paw', class: 'h-9 w-11 -rotate-6' %}</span>
  </div>
  <div class="page-width flex min-h-[200px] flex-col items-center justify-center py-12 text-center text-white md:min-h-[284px]">
    {%- if breadcrumb -%}
      <nav aria-label="Breadcrumb" class="mb-3 text-lg font-medium">
        <a href="{{ routes.root_url }}" class="hover:underline">{{ 'general.home' | t }}</a>/ <span aria-current="page">{{ crumb | default: title }}</span>
      </nav>
    {%- endif -%}
    <h1 class="font-heading text-4xl font-bold text-white md:text-5xl">{{ title }}</h1>
    {%- if subtitle != blank -%}<div class="mt-4 max-w-[620px] text-lg font-medium text-white/90 md:text-xl">{{ subtitle }}</div>{%- endif -%}
  </div>
</div>
