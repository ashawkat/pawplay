[
  {
    "name": "theme_info",
    "theme_name": "PawPlay",
    "theme_version": "0.1.0",
    "theme_author": "Betatech",
    "theme_documentation_url": "https://betatech.co",
    "theme_support_url": "https://betatech.co"
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "header",
        "content": "Color schemes"
      },
      {
        "type": "paragraph",
        "content": "Every section has a Color scheme setting. Edit a scheme here and all sections using it update. Pick a ready-made style under Theme settings \u2192 Theme styles."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Overrides the solid background when set"
          },
          {
            "type": "color",
            "id": "background_soft",
            "label": "Soft background (inputs, panels)",
            "default": "#F8F9FB"
          },
          {
            "type": "color",
            "id": "card",
            "label": "Cards",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "heading",
            "label": "Headings",
            "default": "#252424"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "Muted text",
            "default": "#666666"
          },
          {
            "type": "color",
            "id": "primary",
            "label": "Primary (buttons, prices, links)",
            "default": "#FF6B6B"
          },
          {
            "type": "color",
            "id": "on_primary",
            "label": "Text on primary",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary",
            "label": "Secondary",
            "default": "#4ECDC4"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (highlights, yellow buttons)",
            "default": "#FFE66D"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders",
            "default": "#E6E8EC"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "primary_button": "primary",
          "on_primary_button": "on_primary",
          "primary_button_border": "primary",
          "secondary_button": "card",
          "on_secondary_button": "primary",
          "secondary_button_border": "border",
          "icons": "text",
          "links": "primary"
        }
      },
      {
        "type": "header",
        "content": "Badges"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Rating stars & gold badges",
        "default": "#F4C430"
      },
      {
        "type": "color",
        "id": "color_info",
        "label": "Info accents",
        "default": "#3498DB"
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings_schema.typography.heading",
        "default": "poppins_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings_schema.typography.body",
        "default": "dm_sans_n4"
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "section_spacing",
        "label": "t:settings_schema.layout.section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      }
    ]
  },
  {
    "name": "t:settings_schema.favicon.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.favicon.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_linkedin_link",
        "label": "LinkedIn",
        "placeholder": "https://linkedin.com/company/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "placeholder": "https://youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "https://instagram.com/shopify"
      }
    ]
  },
  {
    "name": "Cart & products",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Side cart (drawer)"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "cart_open_on_add",
        "label": "Open side cart after adding a product",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In your store's default currency. 0 hides the progress bar.",
        "default": 49
      },
      {
        "type": "checkbox",
        "id": "cart_upsell",
        "label": "Show product recommendations in side cart",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "Recommendations heading",
        "default": "Pets also love"
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Allow order note in side cart",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_wishlist_button",
        "label": "Show wishlist button on product cards",
        "default": true
      }
    ]
  }
]